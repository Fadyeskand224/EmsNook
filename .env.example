# Never commit real values.
NODE_ENV=production
# Hosted database (Turso). Required in production unless DATA_DIR points at a persistent disk.
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=
# Optional: a Google Books API key. Adds Google's fan ratings and blurbs on top of Open Library.
GOOGLE_BOOKS_API_KEY=
# Optional: extra origins allowed to make state-changing requests (comma-separated). Normally empty.
ALLOWED_ORIGINS=
