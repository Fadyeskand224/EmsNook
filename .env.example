# Never commit real values.
NODE_ENV=production
# Hosted database (Turso). Required in production unless DATA_DIR points at a persistent disk.
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=
# Optional: a Google Books API key. Adds Google's fan ratings and blurbs on top of Open Library.
GOOGLE_BOOKS_API_KEY=
# Optional: extra origins allowed to make state-changing requests (comma-separated). Normally empty.
ALLOWED_ORIGINS=
# Password-reset emails (https://resend.com). Without a key the link is only printed in the server log.
RESEND_API_KEY=
# Who the email comes from. Needs a domain you have verified with Resend; the default only reaches your own Resend account email.
MAIL_FROM=
# The public address of the site (Render supplies RENDER_EXTERNAL_URL on its own). Reset links are built from this, never from the request.
APP_URL=
